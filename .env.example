# Environment Variables Template for ResumeAI
# Copy this file to .env and fill in your values

# API Gateway URL
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
REACT_APP_API_URL=your-api-gateway-url

# AWS Cognito Configuration
# Find these in AWS Cognito Console
REACT_APP_COGNITO_USER_POOL_ID=your-cognito-pool-id
REACT_APP_COGNITO_CLIENT_ID=your-cognito-client-id
REACT_APP_COGNITO_DOMAIN=your-cognito-domain

# AWS Region
REACT_APP_AWS_REGION=us-east-1

# OAuth Redirect URIs
# Local development
REACT_APP_REDIRECT_URI=http://localhost:3000
REACT_APP_LOGOUT_URI=http://localhost:3000

# Production URLs (uncomment and update for production)
# REACT_APP_REDIRECT_URI=https://your-domain.com
# REACT_APP_LOGOUT_URI=https://your-domain.com

# S3 Bucket for Resume Storage
REACT_APP_UPLOAD_BUCKET=elvin-resumeai-api

# Optional: Additional Configuration
# REACT_APP_DEBUG=false
# REACT_APP_LOG_LEVEL=info
